# ---------------------------------------------------------------------------
# Terraform (infra/)
# ---------------------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraform.tfstate.lock.info
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files may contain secrets/personal values; keep only the example.
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: .terraform.lock.hcl SHOULD be committed.

